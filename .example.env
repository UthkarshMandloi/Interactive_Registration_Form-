# Google OAuth Client ID (for Google Sign-In Popup)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Toggle display of NSS Reg. No. field ("true" to show, "false" to hide)
NEXT_PUBLIC_SHOW_NSS_REG_NO="true"

# Google Sheet ID (From Google Sheet URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit)
GOOGLE_SHEET_ID="your_google_spreadsheet_id_here"

# Google Service Account Email (From Google Cloud Console Service Account key)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"

# Google Service Account Private Key (From JSON key file, enclosed in quotes with \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
